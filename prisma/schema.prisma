// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id        String @id @default(uuid()) // public id, shown to every peer
  tokenHash String // sha256 of the secret session token; the token itself is never stored
  lat       Float // ALREADY privacy-offset coords (raw is never stored)
  lng       Float
  lastSeen  DateTime

  // Connection state. The server only relays a signal if these say the two
  // sessions are actually talking to each other.
  requestedId String? // the peer we asked to connect to and are waiting on
  requestedAt DateTime? // when we last asked, for the request cooldown
  peerId      String? // the peer we are connected to; non-null means "busy"

  @@index([lastSeen])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}
